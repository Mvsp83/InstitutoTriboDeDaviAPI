{
  // Logging estruturado (Serilog). Escreve no console e num arquivo rotativo
  // diário em logs/ (retém 14 dias; logs/ está no .gitignore por *.log).
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/tribo-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  // Monitor de erros (Sentry). Fica INATIVO enquanto o DSN estiver vazio —
  // preencha Sentry:Dsn (dev: user-secrets; produção: env Sentry__Dsn) para
  // começar a receber os erros de produção. Faixa gratuita.
  "Sentry": {
    "Dsn": "",
    "TracesSampleRate": 0.0,
    "SendDefaultPii": false
  },

  // Segredos NÃO ficam neste arquivo:
  // - dev: dotnet user-secrets (ConnectionStrings:TRIBODEDAVIAPI e Jwt:Key)
  // - produção: variáveis de ambiente
  "ConnectionStrings": {
    "TRIBODEDAVIAPI": ""
  },

  "Jwt": {
    "Key": "",
    "HoursToExpire": "8"
  },

  "AllowedHosts": "*",

  // Integração via OAuth 2.0 do usuário (Gmail comum, sem Workspace).
  // Segredos NÃO ficam aqui — dev: user-secrets; produção: env
  // GoogleDrive__ClientId / GoogleDrive__ClientSecret / GoogleDrive__RefreshToken.
  // A pasta raiz (e as subpastas por categoria) são criadas automaticamente.
  "GoogleDrive": {
    "ClientId": "",
    "ClientSecret": "",
    "RefreshToken": "",
    "PastaRaiz": "Instituto Tribo de Davi - Documentos"
  },

  // Envio de email (avisos do calendário). Segredos NÃO ficam aqui — dev:
  // user-secrets (Smtp:User e Smtp:Password); produção: env Smtp__User / Smtp__Password.
  // Ex.: Gmail → Host smtp.gmail.com, Port 587, EnableSsl true, User o email,
  // Password uma "senha de app" (não a senha normal da conta).
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "From": "",
    "HorarioExecucao": "07:00"
  },

